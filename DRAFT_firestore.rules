rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidClient(data) {
      return data.keys().hasAll(['name', 'rut_dni', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.rut_dni is string && data.rut_dni.size() > 0 && data.rut_dni.size() <= 50 &&
             data.createdAt == request.time;
    }

    function isValidAudit(data) {
      return data.keys().hasAll(['title', 'status', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.status in ['draft', 'finalized'] &&
             data.createdAt == request.time;
    }

    // Routes
    match /users/{userId} {
      allow read: if isOwner(userId);

      match /clients/{clientId} {
        allow read, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(clientId) && isValidClient(incoming());
        allow update: if isOwner(userId) && 
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phone', 'address', 'notes', 'updatedAt']) &&
          incoming().updatedAt == request.time;
        allow delete: if isOwner(userId);
      }

      match /audits/{auditId} {
        allow read, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(auditId) && isValidAudit(incoming());
        allow update: if isOwner(userId) && 
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'findings', 'status', 'updatedAt']) &&
          incoming().updatedAt == request.time;
        allow delete: if isOwner(userId);
      }
    }
  }
}
